<div class="ng-hall-stage{{#if frame}} framed{{/if}}" style="transform: scale({{layout.scale}}); left: {{layout.left}}px; top: {{layout.top}}px">
  <img class="ng-hall-map" src="{{art}}/map.webp" alt="Карта Надграда">
  <div class="ng-hall-dim"></div>

  <header class="ng-hall-head">
    <span class="ng-hall-gap"></span>
    <span class="ng-hall-brand"><img class="ng-hall-logo" src="{{art}}/logo.webp" alt=""><span class="ng-hall-title">НАДГРАД</span></span>
    <span class="ng-hall-gap"></span>
    {{{playerHtml}}}
    <span class="ng-hall-head-right">
      <span class="ng-hall-skins" role="group" aria-label="Оформление холла">
        {{#each skins}}<button type="button" data-hall="skin" data-id="{{id}}" class="{{#if on}}on{{/if}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
      </span>
      {{#if isGM}}<button type="button" class="ng-hall-admin" data-hall="admin" title="Холл: новости, музыка, доска дел" aria-label="Настройки холла"><i class="fa-solid fa-gear"></i></button>{{/if}}
    </span>
  </header>

  {{#each photos}}
  <figure class="ng-hall-photo" style="right: {{right}}px; top: {{top}}px; width: {{frame}}px; transform: rotate({{rot}}deg)">
    <img src="{{../art}}/{{file}}" alt="{{alt}}" style="width: {{w}}px; height: {{h}}px">
    <span class="ng-hall-tape" style="transform: rotate({{tape}}deg)"></span>
  </figure>
  {{/each}}

  {{{boardHtml}}}

  <img class="ng-hall-device" src="{{art}}/device.webp" alt="Защищённый коммуникатор">

  <section class="ng-hall-band">
    {{{stripHtml}}}
    <img class="ng-hall-smg" src="{{art}}/smg.webp" alt="Пистолет-пулемёт с граффити">
  </section>

  <footer class="ng-hall-news">
    <span class="ng-hall-news-label">Новости</span>
    <div class="ng-hall-news-window">
      {{#if news.length}}
      <div class="ng-hall-ticker" style="animation-duration: {{tickerSeconds}}s">
        {{#each newsLoop}}<span>{{#if tag}}<b>{{tag}}:</b> {{/if}}{{text}}</span><span class="ng-hall-sep">◆</span>{{/each}}
      </div>
      {{/if}}
    </div>
  </footer>
</div>

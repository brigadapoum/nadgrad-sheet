<div class="ng-status ng-crop">
  <section class="ng-block">
    <h3 class="ng-h">{{name}}</h3>
    <div class="ng-crop-stage">
      {{#if error}}<p class="ng-crop-err">{{error}}</p>{{else}}<canvas class="ng-crop-view" width="640" height="640" aria-label="Вырез под кольцо"></canvas>{{/if}}
    </div>
    <div class="ng-tool">
      <span class="ng-label">Зум</span>
      <input type="range" class="ng-crop-zoom" min="{{zoomMin}}" max="{{zoomMax}}" step="1" value="{{zoomPct}}" {{#if error}}disabled{{/if}}>
      <button type="button" class="ng-ghost" data-action="reset" {{#if error}}disabled{{/if}}>Сбросить</button>
    </div>
    <p class="ng-hint">Тяни картинку мышкой, колесо — ближе / дальше. Кольцо поверх — то, что стоит в мире.</p>
    <div class="ng-tool">
      <span class="ng-grow"></span>
      <button type="button" class="ng-ghost" data-action="close">Отмена</button>
      <button type="button" class="ng-pri" data-action="save" {{#if error}}disabled{{/if}}{{#if busy}} disabled{{/if}}>На стол</button>
    </div>
  </section>
</div>
